{
  "name": "msk-paste",
  "version": "1.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "MSK Paste — Self-hosted pastebin alternative with syntax highlighting, expiration, and password protection",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3012",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "cleanup": "tsx scripts/cleanup.ts",
    "api-key": "tsx scripts/api-key.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.5.0",
    "@swc/helpers": "^0.5.23",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "mysql2": "^3.24.6",
    "nanoid": "^6.0.2",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.5"
